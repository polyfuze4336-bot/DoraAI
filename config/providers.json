  {
    "id": "gdelt-global-news",
    "type": "gdelt",
    "enabled": true,
    "refreshMinutes": 30,
    "baseUrl": "https://api.gdeltproject.org",
    "timespan": "24h",
    "maxRecords": 50,
    "runtime": {
      "timeoutMs": 30000,
      "retry": { "maxAttempts": 4, "baseDelayMs": 5000, "maxDelayMs": 30000 },
      "rateLimit": { "requests": 1, "perMilliseconds": 10000 }
    },
    "queries": {
      "commodity-markets": {
        "query": "(\"crude oil\" OR \"natural gas\" OR LNG OR copper OR aluminum OR nickel OR gold OR \"palm oil\") (price OR supply OR demand OR shipping OR production)",
        "commodityIds": [
          "crude-oil-brent",
          "crude-oil-wti",
          "natural-gas-us",
          "lng-japan",
          "copper",
          "aluminium",
          "nickel",
          "gold",
          "palm-oil"
        ]
      }
    }
  }
