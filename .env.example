DORA_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_DORA_APP_NAME=DORA
NEXT_PUBLIC_DORA_DEMO_MODE=true
NEXT_PUBLIC_DORA_DEMO_STORY_ENABLED=true
DORA_ALLOW_LOCAL_ADMIN=true
DORA_TRUST_ENTRA_HEADERS=false
DORA_ADMIN_PRINCIPAL_IDS=

# Local development bypasses platform Entra auth. Azure prototype uses database.
AUTH_PROVIDER=entra
AUTH_SESSION_SECRET=

# Non-secret provider registry and local persisted output.
PROVIDER_CONFIG_PATH=config/providers.json
INGESTION_OUTPUT_DIR=data/ingested
PROVIDER_FORCE_REFRESH=false

# Optional free provider keys. Keep values in ignored .env.local for development.
# In Azure, resolve these from Key Vault references; never put values in providers.json.
EIA_API_KEY=
FRED_API_KEY=

# Azure services are optional. Local file and lexical stores are used when omitted.
AZURE_CLIENT_ID=
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_CONTAINER=dora-data
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=dora-knowledge
AZURE_SEARCH_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
PGHOST=
PGPORT=5432
PGDATABASE=dora
PGUSER=
PG_USE_ENTRA_IDENTITY=true
PGSSL=true
DORA_DATA_PATH=.dora-data
DORA_LOCAL_DATABASE_PATH=.dora-data/dora-local.db
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft Foundry deployment names are environment-owned and replaceable.
DORA_FOUNDRY_ENDPOINT=
DORA_FOUNDRY_API_VERSION=2024-10-21
DORA_FAST_MODEL=
DORA_REASONING_MODEL=
DORA_EMBEDDING_MODEL=
DORA_AI_TELEMETRY_PATH=.dora-data/ai-requests.jsonl

# Schedule and operational administration.
DORA_SCHEDULE_CONFIG_PATH=config/schedules.json
DORA_SCHEDULE_STATE_PATH=.dora-data/schedule-state.json
SOURCE_ADMIN_STATE_PATH=.dora-data/source-admin.json
DORA_ALERT_PATH=.dora-data/alerts.json

# Monday management brief. Recipient values are runtime configuration only.
DORA_REPORT_TIMEZONE=Asia/Kuala_Lumpur
DORA_REPORT_PATH=.dora-data/reports
DORA_REPORT_RECIPIENTS=
DORA_REPORT_TEST_RECIPIENTS=
AZURE_COMMUNICATION_EMAIL_ENDPOINT=
DORA_REPORT_SENDER_ADDRESS=

# Optional enterprise sources. Unset adapters remain awaiting configuration.
# For entra-application auth, inject standard Azure Identity credentials using Key Vault references.
SHAREPOINT_AUTH_METHOD=managed-identity
SHAREPOINT_MANAGED_IDENTITY_CLIENT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

DATABRICKS_AUTH_METHOD=managed-identity
DATABRICKS_MANAGED_IDENTITY_CLIENT_ID=
DATABRICKS_WORKSPACE_URL=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_TABLE=
DATABRICKS_APPROVED_QUERY=
DATABRICKS_SOURCE_ID_COLUMN=record_id
DATABRICKS_MODIFIED_AT_COLUMN=updated_at
DATABRICKS_COMMODITY_COLUMN=commodity_id

POWER_BI_AUTH_METHOD=managed-identity
POWER_BI_MANAGED_IDENTITY_CLIENT_ID=
POWER_BI_WORKSPACE_ID=
POWER_BI_SEMANTIC_MODEL_ID=
POWER_BI_APPROVED_QUERIES_JSON=